# Copy to secret.yaml (never commit real values) and apply after encoding if needed.
#   kubectl create secret generic agent-cloud-secrets -n agent-cloud --from-env-file=secret.env
#
# Required keys:
#   DATABASE_URL   postgresql+psycopg2://user:pass@rds-endpoint:5432/agent_cloud
#   REDIS_URL      redis://:password@elasticache:6379/0
#   JWT_SECRET     strong random string

apiVersion: v1
kind: Secret
metadata:
  name: agent-cloud-secrets
  namespace: agent-cloud
  labels:
    app.kubernetes.io/name: agent-cloud
type: Opaque
stringData:
  DATABASE_URL: "REPLACE_ME"
  REDIS_URL: "REPLACE_ME"
  JWT_SECRET: "REPLACE_ME"
  # Optional: SMTP, OAuth, API keys — add as needed by your deployment
