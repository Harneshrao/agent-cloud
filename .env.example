# PostgreSQL (required). Must include user + password if the server uses password auth.
#
# Matches repo docker-compose.yml (postgres published on host port 5433 by default):
DATABASE_URL=postgresql://agent:agent@127.0.0.1:5433/agent_cloud
#
# Ad-hoc Docker: docker run -d --name pg -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=agent_cloud postgres:15
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agent_cloud

# Redis (required for task queue)
REDIS_URL=redis://localhost:6379/0

# Optional: queue key prefix (default ac:queue)
# REDIS_QUEUE_PREFIX=ac:queue
